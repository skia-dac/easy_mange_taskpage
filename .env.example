# Copie ce fichier en .env.local (jamais commité) et remplis les valeurs.
# Seules les variables EXPO_PUBLIC_* sont incluses dans l'app : elles sont PUBLIQUES.
# Ne mets JAMAIS ici une clé secrète (ex. la clé "service_role" de Supabase).

# Phase 2 — Supabase (URL du projet et clé "anon"/publishable, protégée par les règles RLS)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
