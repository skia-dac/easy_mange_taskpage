{
  "name": "mysky",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.20",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.117.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-background-task": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:server",
    "test:server": "node scripts/verify-server-sql.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-widgets$": "<rootDir>/src/test/mocks/expoWidgets.ts",
      "^@expo/ui/swift-ui$": "<rootDir>/src/test/mocks/swiftUi.ts",
      "^@expo/ui/swift-ui/modifiers$": "<rootDir>/src/test/mocks/swiftUiModifiers.ts",
      "^react-native-android-widget$": "<rootDir>/src/test/mocks/androidWidget.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "engines": {
    "node": ">=20"
  }
}
