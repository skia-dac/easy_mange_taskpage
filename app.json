{
  "expo": {
    "name": "MySky",
    "slug": "mysky",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skiadac.mysky"
    },
    "android": {
      "package": "com.skiadac.mysky",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6EEFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1F5FD6",
          "dark": {
            "backgroundColor": "#0F1628"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1F5FD6",
          "defaultChannel": "reminders"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "MySky accède à tes photos pour les joindre à tes notes.",
          "cameraPermission": "MySky utilise l’appareil photo pour joindre une photo à tes notes."
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MySky utilise Face ID pour déverrouiller l’application."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.skiadac.mysky",
          "widgets": [
            {
              "name": "NextCourseWidget",
              "displayName": "Prochain cours",
              "description": "Ton prochain cours, son heure et sa salle.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "TodayWidget",
              "displayName": "Aujourd’hui",
              "description": "Tes cours du jour, puis tes tâches et examens proches.",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"]
              }
            },
            {
              "name": "TasksWidget",
              "displayName": "Tâches",
              "description": "Ce qu’il te reste à faire aujourd’hui et en retard.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextCourse",
              "label": "MySky · Prochain cours",
              "description": "Ton prochain cours, son heure et sa salle.",
              "minWidth": "160dp",
              "minHeight": "120dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Today",
              "label": "MySky · Aujourd’hui",
              "description": "Tes cours du jour, puis tes tâches et examens proches.",
              "minWidth": "320dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Tasks",
              "label": "MySky · Tâches",
              "description": "Ce qu’il te reste à faire aujourd’hui et en retard.",
              "minWidth": "160dp",
              "minHeight": "120dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "mysky",
    "experiments": {
      "typedRoutes": true
    }
  }
}
